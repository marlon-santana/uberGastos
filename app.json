{
  "expo": {
    "name": "DriverCash",
    "slug": "drivercash",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./src/shared/assets/icons/icon-1024.png",
    "splash": {
      "image": "./src/shared/assets/icons/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1110"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.marlonnig.drivercash",
      "adaptiveIcon": {
        "foregroundImage": "./src/shared/assets/icons/adaptive-icon-foreground.png",
        "backgroundColor": "#0B1110"
      }
    },
    "plugins": [
      "expo-asset",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ]
  }
}
